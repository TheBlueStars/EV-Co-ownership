{
  "info": {
    "name": "EVCO-Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ownerA@example.com\",\n  \"password\": \"password\",\n  \"fullName\": \"Owner A\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"ownerA@example.com\",\n  \"password\": \"password\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"ownerA@example.com\",\n  \"code\": \"<paste-otp-here>\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api","auth","verify-otp"] }
      }
    },
    {
      "name": "Resend OTP",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/api/auth/resend?email=ownerA@example.com", "host": ["{{baseUrl}}"], "path": ["api","auth","resend"], "query": [{"key":"email","value":"ownerA@example.com"}] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" }
  ]
}
